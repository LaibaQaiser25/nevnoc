        "assignments": {
          "assignments": [
            { "id": "p1", "name": "Date", "value": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}", "type": "string" },
            { "id": "p2", "name": "Name", "value": "={{ $('Lead form').item.json.Name }}", "type": "string" },
            { "id": "p3", "name": "Email", "value": "={{ $('Lead form').item.json.Email }}", "type": "string" },
            { "id": "p4", "name": "Company", "value": "={{ $('Lead form').item.json.Company }}", "type": "string" },
            { "id": "p5", "name": "Message", "value": "={{ $('Lead form').item.json.Message }}", "type": "string" },
            { "id": "p6", "name": "Score", "value": "={{ ($json.output.score || 'warm').toLowerCase() }}", "type": "string" },
            { "id": "p7", "name": "Reason", "value": "={{ $json.output.reason }}", "type": "string" },
            { "id": "p8", "name": "Summary", "value": "={{ $json.output.summary }}", "type": "string" },
            { "id": "p9", "name": "Reply Sent", "value": "={{ $json.output.reply_body ? 'yes' : 'no (spam)' }}", "type": "string" }
          ]
        },
        "options": {}
      },
