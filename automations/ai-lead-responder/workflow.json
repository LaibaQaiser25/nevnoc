    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"score\": \"hot\",\n  \"reason\": \"Needs a WhatsApp booking bot and wants to start this month\",\n  \"summary\": \"Clinic wants appointment booking automated on WhatsApp\",\n  \"reply_subject\": \"Re: automating your bookings\",\n  \"reply_body\": \"Hi Sara, ...\"\n}"
      },
      "id": "a1f0c3c2-5b1e-4f0a-9d4e-000000000006",
      "name": "Structured output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
